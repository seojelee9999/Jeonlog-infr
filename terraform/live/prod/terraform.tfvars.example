aws_region              = "ap-northeast-2"
name_prefix             = "jeonlog-prod"
vpc_cidr                = "10.20.0.0/16"
azs                     = ["ap-northeast-2a", "ap-northeast-2c"]
public_subnet_cidrs     = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs    = ["10.20.101.0/24", "10.20.102.0/24"]
acm_certificate_domain  = "api.example.com"
db_identifier           = "jeonlog-prod-db"
s3_bucket_name          = "jeonlog-prod-assets"
ssh_ingress_cidrs       = ["203.0.113.10/32"]
app_port                = 8080
health_check_path       = "/actuator/health"
ami_id                  = "ami-xxxxxxxxxxxxxxxxx"
instance_type           = "t3.small"
key_name                = "jeonlog-prod-key"
min_size                = 2
max_size                = 4
desired_capacity        = 2
db_snapshot_identifier  = "arn:aws:rds:ap-northeast-2:123456789012:snapshot:jeonlog-prod-snapshot"
db_instance_class       = "db.t3.small"
db_password             = "change-me"
ecr_repository_arn      = "arn:aws:ecr:ap-northeast-2:123456789012:repository/jeonlog-app"
ecr_image_url           = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/jeonlog-app:prod-example"
grafana_allowed_cidrs   = ["203.0.113.10/32"]
grafana_admin_password  = "change-me"
redis_password          = "change-me"
